<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
    <AREADESC areaname="SSL">
        <DESC descname="SSL">
             <PARAS>
                 <PARA name="CERTPATH"  value="style/defaultstyle/conf/ssl"/>
             </PARAS>
        </DESC>
    </AREADESC>
    
    <AREADESC areaname="SECURITY_DEBUG">
        <DESC descname="LOG_LEVEL">
            <PARAS>
                <PARA name="LOG_LEVEL" value="WARN" />
            </PARAS>
        </DESC>
        <DESC descname="LOGFILE_COUNT">
            <PARAS>
                <PARA name="LOGFILE_COUNT" value="10" />
            </PARAS>
        </DESC>        
    </AREADESC>
    
    <!--timeout in millisecond-->
    <AREADESC areaname="SECURITY_TIME">
        <DESC descname="high">
            <PARAS>
                <PARA name="overtime" value="200000" />                
            </PARAS>
        </DESC>
        <DESC descname="middle">
            <PARAS>                
                <PARA name="overtime" value="100000" />                
            </PARAS>
        </DESC>
        <DESC descname="low">
            <PARAS>
                <PARA name="overtime" value="100000" />
            </PARAS>
        </DESC>
    </AREADESC>
    <!--timeout in millisecond End-->    
</COMMINIDATA>
