<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
    <AREADESC areaname="communicate">                                                                                                                                                     
          <DESC descname="communicate">                                    
	          <PARAS>                                                      
	                <!--Timeout(seconds) of invoking method on CORBA object,the value can't less than 10 -->
                        <PARA name="corba_timeout" value="600"/>

	          	<!--time interval(seconds) to send heartbeat event -->
                        <PARA name="heartbeat_interval" value="20"/>
	          	<!-- reconnect to event service if receive no event in the time of value * heartbeat_interval -->
                        <PARA name="heartbeat_timeout" value="2"/>
	          	<!--time interval(seconds) to reconnect with event service-->
                        <PARA name="reconnect_interval" value="5"/>

                        <PARA name="BiDirection" value="false"/>
          	</PARAS>
          </DESC>

<!-- Tne following configuration is for iMAP1.2(ASN.1 communicate)         -->

        <DESC descname="ProcID">                                       
            <PARAS>                                                    
                <PARA name="default" value="0xFF" />                   
            </PARAS>                                                   
        </DESC>                                                        
        <DESC descname="Debug">                                        
            <PARAS>                                                    
                <PARA name="DebugEnable" value="true" />               
                    <!--                                                   
                 DebugLevel has the following values:                  
                 ALL,TRACE,WARNING,ERROR                               
                -->                                                    
               <PARA name="DebugLevel" value="TRACE" />                
                                                                       
            <PARA name="NoTraceCommands">                              
                <VALUE  value="" />                                    
                <VALUE  value="" />                                    
            </PARA>                                                    
                                                                       
                                                                       
            </PARAS>                                                   
        </DESC>                                                        
        <DESC descname="Reconnect">                                    
           <PARAS>                                                     
           	<PARA name="Limited" value="false" />                       
           	<PARA name="timeOut" value="6000" />                        
           </PARAS>                                                    
           	<DESC descname="Properties">                               
           	    <PARAS>                                                
	           	<PARA name="interval" value="1" />                     
    	           	<!-- only for reconnection of limited times-->         
	           	<PARA name="maxtimes" value="10" />                    
           	                      	                                   
           	    </PARAS>            	                               
           	</DESC>                                                    
        </DESC>                                                        
                                                                       
         <DESC descname="Send">                                        
            <PARAS>                                                    
                    <!-- timOut's value should range from 1 to 10000 -->
                <PARA name="timeOut" value="600" />                      
            </PARAS>                                                   
        </DESC>                                                        

    </AREADESC>
</COMMINIDATA>
