<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
	<AREADESC>
		<!--
			子系统的基本内容描述，
			ID      表示子系统的唯一标识,该属性是必须的
			Label   该子系统的名字，该属性是必须的
			IMage   子系统图标对应的文件位置，这个是可选的
		-->
		<DESC descname="feature">
			<PARAS>
				<PARA name="id" value="sysmonitor"></PARA>
				<PARA name="label" value="sysmonitorclient_name"></PARA>
				<PARA name="image" value="icon.gif"></PARA>				
			</PARAS>
		</DESC>

		<!-- 子系统的其他属性描述 -->
		<DESC descname="extra">
			<PARAS>
				<!-- 加载对话框图片，用于显示在登录后的进度对话框中 -->
				<PARA name="image.loading" value="loading.png"></PARA>
				<!-- 锁定对话框图片，用于显示在客户端锁定/解锁对话框中 -->
				<PARA name="image.lock" value="lockdialog.gif"></PARA>
				<!-- 退出对话框图片，用于显示在退出确认对话框中 -->
				<PARA name="image.exit" value="logoutdialog.gif"></PARA>
				<!-- 子系统版本，用于显示在关于对话框中 -->
				<PARA name="about.version" value="about.version"></PARA>
				<!-- 子系统描述，用于显示在关于对话框中 -->
				<PARA name="about.desc" value="about.desc"></PARA>
				<!-- 关于对话框图片，用于显示在关于对话框 -->
				<PARA name="about.image.banner"
					value="about_banner.gif">
				</PARA>
				<!-- 关于对话框标题图片，用于显示在关于对话框中 -->
				<PARA name="about.image.title"
					value="about_title.png">
				</PARA>
				<PARA name="ishidetabbedbar" value="true"></PARA>
			</PARAS>
		</DESC>

		<DESC descname="plugins">
			<PARAS>
			    <PARA name="loginui"></PARA>
			    <PARA name="com.swimap.orbbase"></PARA>
			    <PARA name="com.swimap.mrb"></PARA>
			    <PARA name="em"></PARA>
			    <PARA name="sysmonitor"></PARA>
			</PARAS>
		</DESC>

		<!-- 
			子系统启动所需的模块列表
			name=""  模块的唯一的标识，这个是必须的       
		-->
		<DESC descname="required-plugins">
			<PARAS>
			 <PARA name="U2000_Solution"></PARA>
			 <PARA name="U2000_EM"></PARA>			 
                <!-- PARA name="unitedmgr_sysmonitor"></PARA --> <!-- BJ2D14223 y00146291 2010-6-4 10:39 -->
			</PARAS>
		</DESC>
	</AREADESC>
</COMMINIDATA>