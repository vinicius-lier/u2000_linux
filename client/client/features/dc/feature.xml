<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
  <AREADESC>
    <!--
                        子系统的基本内容描述，
                        ID      表示子系统的唯一标识,该属性是必须的
                        Label   该子系统的名字，该属性是必须的
                        IMage   子系统图标对应的文件位置，这个是可选的
                -->
    <DESC descname="feature">
      <PARAS>
        <PARA name="id"
              value="dc"></PARA>
        <PARA name="label"
              value="dc"></PARA>
        <PARA name="image"
              value="icon.gif"></PARA>
      </PARAS>
    </DESC>
    <!-- 子系统的其他属性描述 -->
    <DESC descname="extra">
      <PARAS>
        <!-- 加载对话框图片，用于显示在登录后的进度对话框中 -->
        <PARA name="image.loading"
              value="loading.png"></PARA>
        <!-- 锁定对话框图片，用于显示在客户端锁定/解锁对话框中 -->
        <PARA name="image.lock"
              value="lockdialog.gif"></PARA>
        <!-- 退出对话框图片，用于显示在退出确认对话框中 -->
        <PARA name="image.exit"
              value="logoutdialog.gif"></PARA>
        <!-- 子系统版本，用于显示在关于对话框中 -->
        <PARA name="about.version"
              value="about.version"></PARA>
        <!-- 子系统描述，用于显示在关于对话框中 -->
        <PARA name="about.desc"
              value="about.desc"></PARA>
        <!-- 关于对话框图片，用于显示在关于对话框 -->
        <PARA name="about.image.banner"
              value="about_banner.gif"></PARA>
        <!-- 关于对话框标题图片，用于显示在关于对话框中 -->
        <PARA name="about.image.title"
              value="about_title.png"></PARA>
        <PARA name="ishidetabbedbar"
              value="false"></PARA>
      </PARAS>
    </DESC>
    <DESC descname="plugins">
      <PARAS>
        <PARA name="dc"></PARA>
      </PARAS>
    </DESC>
    <DESC descname="required-plugins">
      <PARAS>
        <PARA name="com.swimap.extension.registry"></PARA>
        <PARA name="authentication"></PARA>
        <PARA name="loginui"></PARA>	
        <PARA name="clientutil"></PARA>
        <PARA name="resource"> </PARA> 
        <PARA name="eam"> </PARA>
        <PARA name="topobase"> </PARA>
        <PARA name="topoclient"> </PARA>
        <PARA name="com.swimap.adapter.message.common"> </PARA>
        <PARA name="com.swimap.adapter.message.general"> </PARA>
        <PARA name="com.swimap.adapter.message.resource"> </PARA>
        <PARA name="com.swimap.adapter.message.sm"> </PARA>
        <PARA name="em"> </PARA>        
        <PARA name="com.swimap.color"> </PARA>      
        <PARA name="com.swimap.adapter.message.tm"></PARA>
        
        <PARA name="com.swimap.sound"></PARA>
        <PARA name="lm"></PARA>
        <PARA name="securitymanager"></PARA>
        <PARA name="clientutilAdapter"></PARA>
        <PARA name="com.swimap.orbbase"></PARA>
        <PARA name="log"></PARA>
        <PARA name="com.swimap.ftp"></PARA>
      </PARAS>
    </DESC>
  </AREADESC>
</COMMINIDATA>
