<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
	<AREADESC>
		<!--
			子系统的基本内容描述，
			ID      表示子系统的唯一标识,该属性是必须的
			Label   该子系统的名字，该属性是必须的
			IMage   子系统图标对应的文件位置，这个是可选的
		 -->
		<DESC descname="feature">
			<PARAS>
				<PARA name="id" value="nemgr_rps"></PARA>
				<PARA name="label" value="nemgr_rps"></PARA>
			</PARAS>
		</DESC>
		<!-- 子系统的其他属性描述 -->
		<DESC descname="extra">
			<PARAS>
				<!-- 加载对话框图片，用于显示在登录后的进度对话框中 -->
				<PARA name="image.loading" value=""></PARA>
				<!-- 锁定对话框图片，用于显示在客户端锁定/解锁对话框中 -->
				<PARA name="image.lock" value=""></PARA>
				<!-- 退出对话框图片，用于显示在退出确认对话框中 -->
				<PARA name="image.exit" value=""></PARA>
				<!-- 子系统版本，用于显示在关于对话框中 -->
				<PARA name="about.version" value="about.version"></PARA>
				<!-- 子系统描述，用于显示在关于对话框中 -->
				<PARA name="about.desc" value="about.desc"></PARA>
				<!-- 关于对话框图片，用于显示在关于对话框 -->
				<PARA name="about.image.banner"
					value="">
				</PARA>
				<!-- 关于对话框标题图片，用于显示在关于对话框中 -->
				<PARA name="about.image.title"
					value="">
				</PARA>
			</PARAS>
		</DESC>



		<DESC descname="plugins">
			<PARAS>
			  <PARA name="nemgr_rps"/>
			</PARAS>
		</DESC>

	</AREADESC>
</COMMINIDATA>
