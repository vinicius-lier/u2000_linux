<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<!--
	four types of the command can be defined now
	
	sci:static class invoke
	ici:instance class invoke
	cic:cross invoke
	pic:process invoke
-->
<!--
	security info
	
	name            present                            value
	"security"     securityType                0 always not allowed, 1 always allowed, 2 moi realated, 3 moi not related.
	"moiID"        moi object ID
	"appID"        application object ID
	"oprID"        operation ID
	
-->
<COMMINIDATA>
	<AREADESC>
		<DESC descname="commandlist">

			<DESC descname="openAppCommand">
				<PARAS>
					<PARA name="actionType" value="cic"></PARA>
					<PARA name="moduleID"
						value="com.swimap.iscript.app">
					</PARA>
					<PARA name="className"></PARA>
					<PARA name="processName"></PARA>
					<PARA name="methodName"
						value="openAppManageFrame">
					</PARA>
					<PARA name="security" value="3"></PARA>
					<PARA name="accessID"
						value="SystemMaintenance.iSStarAppMgt">
					</PARA>
					<PARA name="moiID" value="0"></PARA>
					<PARA name="objectClassName"
						value="SystemMaintenance">
					</PARA>
				</PARAS>
			</DESC>

         <DESC descname="openScriptCommand">
				<PARAS>
					<PARA name="actionType" value="cic"></PARA>
					<PARA name="moduleID"
						value="com.swimap.iscript.app">
					</PARA>
					<PARA name="className"></PARA>
					<PARA name="processName"></PARA>
					<PARA name="methodName"
						value="openMainFrame">
					</PARA>
					<PARA name="security" value="3"></PARA>
					<PARA name="accessID"
						value="SystemMaintenance.iSStarDevelop">
					</PARA>
					<PARA name="moiID" value="0"></PARA>
					<PARA name="objectClassName"
						value="SystemMaintenance">
					</PARA>
					<PARA name="license" value="LNSDMAMFC11,LNSDISSTAR02,LNSDINMFB01"></PARA>
				</PARAS>
			</DESC>      

		</DESC>
	</AREADESC>
</COMMINIDATA>


