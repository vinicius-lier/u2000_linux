<?xml version="1.0" encoding="UTF-8"?>
<!--
 1:拓扑公共菜单，2:EMS自己生成菜单，3:根据配置文件生成菜单，4:1+2;5:1+3
CLIENTMODULE :表示该视图类型关联的前台ID
SUBMAP:		表示子图菜单的生成方式
DISPLAYLINK:	表示连接菜单的生成方式
NODE：		表示节点的生成方式
VIEW:		表示视图空白菜单的生成方式
MULT OBJECT:	表示多个对象菜单生成方式
-->


<!-- 机架视图取消[资源统计菜单的配置文件] -->

<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">
<COMMINIDATA>
<AREADESC areaname="VIEW_TYPE_MENU">
    <DESC descname="VIEW_TYPE"> 
        <PARAS>
            <PARA name="VIEW_TYPE" value="2"/>
            <PARA name="CLASSNAME" value="com.swimap.imap.topo.util.EmfTopoDefaultMenuGenerator"/>
            <PARA name="SUBMAP_MODE" value="1"/>
            <PARA name="DISPLAYLINK_MODE" value="5"/>
            <PARA name="MULITOBJECT_MODE" value="5"/>
            <PARA name="EMPTYAREA_MODE" value="5"/>
            <PARA name="NODE_MODE" value="5"/>
            <PARA name="PHYSICALLINK_MODE" value="5"/>
        </PARAS>
    </DESC>
</AREADESC>
</COMMINIDATA>
