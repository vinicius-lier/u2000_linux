<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd">


<COMMINIDATA>

	<AREADESC>
		<!-- define a menuSet
			menuSet:
			descname as the menuSet's id, must be unique.
			must have a type para, and the value is "MenuSet"
			JMenu:(super class must be JMenu)
			descname as the menuID.
			must hava a type para, and the value is "JMenu"
			JMenu's sub element
			type can be "JMenuItem", "Separator " ," CheckBox","RadioButton"
		-->

		<DESC descname="ResourceBundle">
			<PARAS>
				<PARA name="type" value="ResourceBundle"></PARA>
				<PARA name="resourceBundleName" value="Res"></PARA>
			</PARAS>
		</DESC>

		<!-- mainMenu MenuSet type start  -->
		<DESC descname="mainMenu">
			<PARAS>
				<PARA name="name" value="main Menu"></PARA>
				<PARA name="type" value="MenuSet"></PARA>
			</PARAS>

			<!-- define a menu have" name" and "mnemonic" attributes -->
			<DESC descname="Tools">
				<PARAS>
					<PARA name="name" value="Tools"></PARA>
					<PARA name="mnemonic" value="T"></PARA>
					<PARA name="accelerator" value="VK_T"></PARA>
					<PARA name="type" value="JMenu"></PARA>
					<PARA name="icon" value=""></PARA>
					<PARA name="serialnumber" value="500"></PARA>
				</PARAS>

				<!-- define a menuitem -->
				<DESC descname="BroadCast Message">
					<PARAS>
						<PARA name="name"
							value="Broadcast_Message...">
						</PARA>
						<PARA name="icon" value=""></PARA>
						<PARA name="command" value="iview BroadCast Send"></PARA>
						<PARA name="type" value="JMenuItem"></PARA>
						<PARA name="mnemonic" value="R"></PARA>
						<PARA name="accelerator" value="VK_R"></PARA>
						<PARA name="Class" value="IViewJMenuItemEx"></PARA>
						<PARA name="serialnumber" value="500-30"></PARA>
						<PARA name="isEnableShortcut" value="true"></PARA>
						<PARA name="ShortcutTitle" value="BroadCast message"></PARA>
						<PARA name="ShortcutIcon" value="icons/BroadCastMessage.gif"></PARA>
						<PARA name="ShortcutDescription" value="BroadCast message"></PARA>
					</PARAS>
				</DESC>
			</DESC>
		</DESC>
		<!--  mainMenu MenuSet type ended  -->
	</AREADESC>
</COMMINIDATA>
