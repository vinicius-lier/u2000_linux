<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE COMMINIDATA SYSTEM "commini.dtd" [
]>

<!--
four types of the command can be defined now

sci:static class invoke
ici:instance class invoke
cic:cross invoke
pic:process invoke
 -->

<!--
 security info

 name            present                            value
"security"     securityType                0 always not allowed, 1 always allowed, 2 moi realated, 3 moi not related.
"moiID"        moi object ID
"appID"        application object ID
"oprID"        operation ID
 -->
<COMMINIDATA>
    <AREADESC>

        <!-- Begin The command of systemmonit management -->
        <DESC descname="toolbarmanagement">
            <PARAS/>
            <DESC descname="start all server">
                <PARAS>
                    <PARA name="actionType" value="cic"/>
                    <PARA name="moduleID" value="MonitorModule"/>
                    <PARA name="methodName" value="startAllServer"/>
                    <PARA name="security" value="3"/>
                </PARAS>
            </DESC>
            <DESC descname="stop all server">
                <PARAS>
                    <PARA name="actionType" value="cic"/>
                    <PARA name="moduleID" value="MonitorModule"/>
                    <PARA name="methodName" value="stopAllServer"/>
                    <PARA name="security" value="3"/>
                    <!--PARA name="objectClassName" value="SystemMaintenance"></PARA>
				<PARA name="moiID" value="0"></PARA>
				<PARA name="accessID" value="Refresh server"></PARA-->
                </PARAS>
            </DESC>
             <DESC descname="ShutDown NMS">
