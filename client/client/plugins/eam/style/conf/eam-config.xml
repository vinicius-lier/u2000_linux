	<AREADESC areaname="common">
		<DESC descname="common">
			<PARAS>
			  <!-- Object Name length,the range is[32,128],default value is 64-->
        <PARA name="NAME_LENGTH" value="64" />
				<!-- neNameFilter -->
				<PARA name="neNameFilter" value="@!&quot;'[]\,"/>
				<!-- '0':deleting subnet with no null is unallowed, '1':deleting subnet with no null is allowed, moving child node up -->
                                <PARA name="deleteSnPolicy" value="1" />                           
				<!-- max configure value is 2000,default value is 500-->
				<PARA name="searchResultNum" value="0"/>
				<!-- set height of pagination tree-->
				<PARA name="treeRowHeight" value="20"/>
				<!--  deleting object'number of Eam for one time --> 
				<!--the value between 1 and 500 ,if value less 1,deleting number is 1,if value more than 500;deleting number is 500-->
				<PARA name="deleteEamObjNum" value="500"/>
				 <!--// if the number less then 30 in the result of the 'ping',set it to 30-->
                            <!--//if the number more then 1000 in the result of the 'ping',set it to 1000-->
				<PARA name="pingResultNum" value="50"/>
				<!--set the auto detect default SNMP version  1,SNMPV1;2,SNMPV2;3,SNMPV3 default:1-->
				<!--<PARA name="defaultSNMPVersion"  value="1"/>-->
			</PARAS>
		</DESC>
	</AREADESC>
