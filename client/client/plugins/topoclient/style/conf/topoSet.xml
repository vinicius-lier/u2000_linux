    <DESC descname="IS_TWINKLE">
      <PARAS>
        <PARA name="SELECT"
              value="false" />
        <PARA name="DEFAULT_SELECT"
              value="false" />
      </PARAS>
    </DESC>
    <DESC descname="SHOW_UNACK_ALARM">
      <PARAS>
        <PARA name="SELECT"
              value="true" />
        <PARA name="DEFAULT_SELECT"
              value="true" />
      </PARAS>
    </DESC>
	<DESC descname="SHOW_UNCLEAR_ALARM">
      <PARAS>
        <PARA name="SELECT"
              value="true" />
        <PARA name="DEFAULT_SELECT"
              value="true" />
      </PARAS>
    </DESC>
    <DESC descname="SHOWCOLOR">
      <PARAS>
        <PARA name="SELECT"
