#Display string for package name
#子系统名称，key值iMAP_CorbaAgent为子系统描述文件中定义的子系统名称
AgentCORBA=North-Bound CORBA Interface
#子系统的安装信息描述
AgentCORBA.InstallInfo = Supports CORBA NBI functions.Including the functions of managing the alarms, inventory, service configuration, and performance data in the transport domain, and the functions of managing alarms in the router and access domains.
