####################################################################
#       SingleOSS 1.0 U2000按场景安装界面资源文件(en_US)
#
#   nw.scenario.displayName.xxxxx.name    按场景安装资源
#   nw.scenario.subsystemtree.xxxx.name   组件树提示资源
#
####################################################################


#-----------------------------------------------------------------------传送单域
nw.scenario.displayName.trans.name              = Transmission
nw.scenario.subsystemtree.trans.name            = Transmission

#-------------------------------------------------------------------------IP单域
nw.scenario.displayName.ip.name                 = IP
nw.scenario.subsystemtree.ip.name               = IP

#-----------------------------------------------------------------------接入单域
nw.scenario.displayName.access.name             = Access
nw.scenario.subsystemtree.access.name           = Access

#--------------------------------------------------------------------接入域+IP域
nw.scenario.displayName.access.ip.name          = Access + IP
nw.scenario.subsystemtree.access.ip.name        = Access + IP

#------------------------------------------------------------------传送域+接入域
nw.scenario.displayName.trans.access.name       = Transmission + Access
nw.scenario.subsystemtree.trans.access.name     = Transmission + Access

#--------------------------------------------------------------------传送域+IP域
nw.scenario.displayName.trans.ip.name           = Transmission + IP
nw.scenario.subsystemtree.trans.ip.name         = Transmission + IP

#----------------------------------------------------------------------U2000全域
nw.scenario.displayName.nw.name                 = U2000(IP + Access + Transmission)
nw.scenario.subsystemtree.nw.name               = U2000(IP + Access + Transmission)



#--------------------------------------------------------U2000+ (核心网独立安装)
nw.scenario.displayName.rc.name                 = Core Network
nw.scenario.subsystemtree.rc.name               = Core Network

#-----------------------------------------------------------U2000+ (接入+核心网)
nw.scenario.displayName.rc.access.name          = Core Network + Access
nw.scenario.subsystemtree.rc.access.name        = Core Network + Access

#---------------------------------------------------------U2000+ (路由器+核心网)
nw.scenario.displayName.rc.iprouter.name        = Core Network + IP 
nw.scenario.subsystemtree.rc.iprouter.name      = Core Network + IP 
