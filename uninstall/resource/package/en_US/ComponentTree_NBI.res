################################################################################
#                   SingleOSS 1.0 U2000组件树资源(en_US)
#
#
################################################################################

NBI                                     = North-Bound Interface
NBI.InstallInfo                         = North-Bound Interface

AgentCORBA_COMPONENT                    = North-Bound CORBA Interface
AgentCORBA_COMPONENT.InstallInfo        = Supports CORBA NBI functions.Including the functions of managing the alarms, inventory, service configuration, and performance data in the transport domain, and the functions of managing alarms in the router and access domains.
AgentXML_COMPONENT                      = North-Bound XML Interface
AgentXML_COMPONENT.InstallInfo          = Supports XML NBI functions.Including the functions of managing the alarms, inventory, service configuration, and performance data.
AgentSNMP_COMPONENT                     = North-Bound SNMP Interface
AgentSNMP_COMPONENT.InstallInfo         = Supports SNMP NBI functions.Including the functions of alarm forwarding,alarm resynchronization,alarm acknowledging,alarm anti-acknowledging and alarm clearance.
AgentTEXT_COMPONENT                     = North-Bound Text Interface
AgentTEXT_COMPONENT.InstallInfo         = Supports Text NBI functions.Including the functions of performance & inventory exporting.
AgentTMF615_COMPONENT                   = North-Bound TMF615 Interface 
AgentTMF615_COMPONENT.InstallInfo       = North-Bound TMF615 Interface.
