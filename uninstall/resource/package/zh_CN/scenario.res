####################################################################
#       SingleOSS 1.0 U2000按场景安装界面资源文件(zh_CN)
#
#   nw.scenario.displayName.xxxxx.name    按场景安装资源
#   nw.scenario.subsystemtree.xxxx.name   组件树提示资源
#
####################################################################


#-----------------------------------------------------------------------传送单域
nw.scenario.displayName.trans.name              = 传送单域
nw.scenario.subsystemtree.trans.name            = 传送单域

#-------------------------------------------------------------------------IP单域
nw.scenario.displayName.ip.name                 = IP单域
nw.scenario.subsystemtree.ip.name               = IP单域

#-----------------------------------------------------------------------接入单域
nw.scenario.displayName.access.name             = 接入单域
nw.scenario.subsystemtree.access.name           = 接入单域

#--------------------------------------------------------------------接入域+IP域
nw.scenario.displayName.access.ip.name          = 接入域+IP域
nw.scenario.subsystemtree.access.ip.name        = 接入域+IP域

#------------------------------------------------------------------传送域+接入域
nw.scenario.displayName.trans.access.name       = 传送域+接入域
nw.scenario.subsystemtree.trans.access.name     = 传送域+接入域

#--------------------------------------------------------------------传送域+IP域
nw.scenario.displayName.trans.ip.name           = 传送域+IP域
nw.scenario.subsystemtree.trans.ip.name         = 传送域+IP域

#----------------------------------------------------------------------U2000全域
nw.scenario.displayName.nw.name                 = U2000全域(IP域+接入域+传送域)
nw.scenario.subsystemtree.nw.name               = U2000全域(IP域+接入域+传送域)



#--------------------------------------------------------U2000+ (核心网独立安装)
nw.scenario.displayName.rc.name                 = 核心网独立安装
nw.scenario.subsystemtree.rc.name               = 核心网独立安装

#-----------------------------------------------------------U2000+ (接入+核心网)
nw.scenario.displayName.rc.access.name          = 核心网+接入
nw.scenario.subsystemtree.rc.access.name        = 核心网+接入

#---------------------------------------------------------U2000+ (路由器+核心网)
nw.scenario.displayName.rc.iprouter.name        = 核心网+IP
nw.scenario.subsystemtree.rc.iprouter.name      = 核心网+IP

