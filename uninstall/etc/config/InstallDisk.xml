    <!--  ########################### License校验 ###########################  -->
    <!--  ########安装时网管License合法性检查属性#######  -->
    <!--  NMS license attributes  -->
    <License>
        <!--  ########old表示使用原来的license策略，AdaptiveLM表示使用AdaptiveLM的license策略########  -->
        <!--  old is use old license check rule, AdaptiveLM is use AdaptiveLM's license check rule  -->
        <Strategy>AdaptiveLM</Strategy>
        <!--  ########申请网管license时使用的产品名称########  -->
        <!--  NMS license product name  -->
        <ProductName>iManager U2000</ProductName>
        <!--  ########申请网管license时使用的产品版本########  -->
        <!--  NMS license version  -->
        <ProductVersion>V200R017</ProductVersion>
    </License>

