<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans>
    <!--    
    Reserve files, indication witch file should be reserved after upgrade
    -->
        <bean id="ReserveFiles" class="java.util.HashSet">              
                <constructor-arg>
                    <set>
                        <value>client/client/style/defaultstyle/conf/ssl/certificateConfig.xml</value>
                        <value>client/client/style/defaultstyle/conf/ssl/keyStore/PFX/client.p12</value>
                    </set>                  
                </constructor-arg>
        </bean>
</beans>