<?xml version="1.0" encoding="utf-8"?><!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd"><!--###########################################################     SingleOSS 1.0 custormized for CAU###########################################################--><beans>    <!-- CAU 下载目录 -->    <bean id="include" class="java.util.Properties">        <constructor-arg>            <props>                <prop key="client">all</prop>                <prop key="cau/bin">all</prop>                <prop key="cau/config">all</prop>                <prop key="cau/installinfo/windows">Windows</prop>                <prop key="cau/installinfo/solaris">SunOS</prop>                <prop key="cau/installinfo/linux">Linux</prop>                <prop key="cau/lib">all</prop>                <prop key="cau/resource">all</prop>                <prop key="uninstall">auto</prop>            </props>        </constructor-arg>    </bean>            <!-- CAU 下载时需要忽略的目录，即不会下载的目录 -->    <bean id="ignore" class="java.util.HashSet">        <constructor-arg>            <set>                <value>client/client/style/all users</value>                <value>client/client/style/users</value>                <value>client/client/configuration/launch</value>				<value>client/client/configuration/MetaData</value>				<value>client/client/configuration/setting</value>				<value>client/client/configuration/topoicon</value>				<value>client/client/configuration/Serializable</value>				<value>client/client/configuration/iView</value>                <value>client/client/tracefile</value>                <value>client/client/var</value>                <value>uninstall/jre_others</value>                <value>uninstall/shortcuts</value>                <value>uninstall/DynamicFileBackup</value>                <value>client/logs</value>				<value>client/client/style/defaultstyle/conf/ssl/keyStore/PFX/</value>            </set>        </constructor-arg>    </bean>            <!-- 配置需要特殊处理CAU下载的客户端路径 -->    <!-- 平台调整为2层client目录，即不需要配置，CAU进行适配  -->    <bean id="configfolder" class="java.util.HashSet">        <constructor-arg>            <set>                <value/>            </set>        </constructor-arg>    </bean>            <!-- 操作系统默认文件限制 -->    <bean id="oslimit" class="java.util.HashMap">        <constructor-arg>            <map>                <entry key="dll" value="Windows"/>                <entry key="bat" value="Windows"/>                <entry key="exe" value="Windows"/>                <entry key="so" value="SunOS,Linux"/>                <entry key="sh" value="SunOS,Linux"/>            </map>        </constructor-arg>    </bean>            <!-- CAU客户端使用的JRE -->    <bean id="configJRE" class="com.swimap.cmf.cau.model.JRE" >        <constructor-arg >            <map>                <entry key = "NMSROOT"  value = "OSSJRE/jre_win" />             </map>        </constructor-arg >        <constructor-arg>            <map>                <entry key = "NMSROOT"  value = "OSSJRE/jre_sol" />            </map>        </constructor-arg>        <constructor-arg>            <map>                <entry key = "NMSROOT"  value = "OSSJRE/jre_linux" />             </map>        </constructor-arg>        <constructor-arg>            <map>                <entry key = "NMSROOT"  value = "jre" />            </map>        </constructor-arg>    </bean>        <!-- CAU客户端默认安装的路径 -->    <bean id="defaultInstallPath" class="java.util.Properties">        <constructor-arg>            <props>                <prop key="windows.client.init.root">D:\oss</prop>                <prop key="sunOs.client.init.root">/opt/oss</prop>            </props>        </constructor-arg>    </bean>            <!-- CAU安装界面框架显示产品标题 -->    <bean id="frameTitle" class="java.util.Properties">        <constructor-arg>            <props>                <prop key="upgrade.frame.title.zh">iManager U2000 统一网络管理系统</prop>                <prop key="upgrade.frame.title.en">iManager U2000 Unified Network Management System</prop>                <prop key="upgrade.frame.title.size">20</prop>            </props>        </constructor-arg>    </bean>            <!-- MDP配置：CAU会把CAU服务器的IP地址写到登录列表中，这样启动客户端时可以方便登录服务器，不用输入IP -->    <bean id="mdpConfig" class="java.util.Properties">        <constructor-arg>            <props>                <!-- client客户端 -->                <prop key="login.source.path">client/client/plugins/loginui/style/conf/loginui/loginserverinfo.xml</prop>                <prop key="login.target.path">client/client/plugins/loginui/style/conf/loginui/loginserverinfo.xml</prop>                <prop key="start.login.flag">login</prop>                                <!-- sysmointor客户端 -->                <prop key="sys.monitor.mdp.source.path">client/client/plugins/loginui/style/conf/loginui/MonitorModule_loginserverinfo.xml</prop>                <prop key="sys.monitor.mdp.target.path">client/client/plugins/loginui/style/conf/loginui/MonitorModule_loginserverinfo.xml</prop>                <prop key="start.sys.monitor.flag">monitor</prop>            </props>        </constructor-arg>    </bean>            <!-- CAU安装界面框架显示产品标题 -->    <bean id="detail" class="java.util.Properties">        <constructor-arg>            <props>                <prop key="productname">iManager U2000 Unified Network Management System</prop>                <prop key="productname.en">iManager U2000 Unified Network Management System</prop>                <prop key="productname.zh">iManager U2000 统一网络管理系统</prop>                <prop key="comparemethod">1</prop>            </props>        </constructor-arg>    </bean>            <!-- 窗口检测 -->    <bean id="window1" class="com.swimap.cmf.cau.model.ClientWindow">        <property name="className" value="SunAwtFrame"/>        <property name="title_en" value="iManager U2000"/>        <property name="title_zh" value="iManager U2000"/>        <property name="os" value="windows"/>    </bean>        <bean id="identifierWindows" class="com.swimap.cmf.cau.model.WindowIdentifier">        <property name="windowList">            <list>                <ref bean="window1"/>            </list>        </property>    </bean></beans>